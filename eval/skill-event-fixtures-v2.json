        "first_task_tool_event_index": 1,
        "event_index_source": "fixture-modeled-single-monotonic-stream",
        "skills_invoked": [
          {
            "skill": "ccl-skills:testing-strategy",
            "event_index": 0,
            "tool_use_id": "toolu_owner",
            "matching_tool_result": true,
            "completed": true
          }
        ]
      },
      "expected_matched_call": {
        "decision": "fixture-pass",
        "reason_code": "fixture_matched_call_satisfied"
      }
    },
