                "input": {"skill": "ccl-skills:testing-strategy"}
              }
            ]
          }
        },
        {
          "type": "user",
          "message": {
            "content": [
              {"type": "tool_result", "tool_use_id": "toolu_owner"}
            ]
          }
        },
        {
          "type": "assistant",
          "message": {
            "content": [
              {"type": "tool_use", "id": "toolu_task", "name": "Task", "input": {}}
            ]
          }
        }
      ],
      "expected": {
        "schema_version": 1,
        "event_contract_version": "skill-events-v2",
        "event_contract_status": "stable",
        "skill_events_available": true,
