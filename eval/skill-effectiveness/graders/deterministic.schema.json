{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccl-skills:deterministic-grade:v1",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "trial_fingerprint", "checks", "passed"],
  "properties": {
    "task_id": {"type": "string"},
    "trial_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "passed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"passed": {"const": true}},
        "required": ["passed"]
      },
      "then": {
        "properties": {
          "checks": {
            "not": {
              "contains": {
                "properties": {"passed": {"const": false}},
                "required": ["passed"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"passed": {"const": false}},
        "required": ["passed"]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {"passed": {"const": false}},
              "required": ["passed"]
            }
          }
        }
      }
    }
  ]
}
