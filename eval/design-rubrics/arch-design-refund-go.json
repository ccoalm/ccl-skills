  "items": [
    {
      "id": "inv_refund_cap",
      "class": "invariant",
      "statement": "For one order, the sum of refunds that succeeded or are still in progress never exceeds the amount paid, including when two refund requests for the same order are processed at the same time."
    },
    {
      "id": "inv_refund_idempotent",
      "class": "invariant",
      "statement": "A retried refund request and a repeated channel callback do not create or apply a second refund: one refund request maps to at most one refund."
    },
    {
      "id": "inv_refund_terminal",
      "class": "invariant",
      "statement": "A refund that reached a final result (succeeded or failed) never changes again; a late or out-of-order callback carrying an earlier status is ignored."
    },
    {
      "id": "inv_order_closed",
      "class": "invariant",
      "statement": "No refund can be created for an order that is closed."
    },
    {
      "id": "stack_go_deadline",
      "class": "stack",
      "statement": "Calls to the external dependency carry a deadline or timeout, propagated through context.Context."
    },
    {
      "id": "stack_go_dal_boundary",
      "class": "stack",
      "statement": "Database access sits behind a DAL or repository boundary and handlers do not construct database or external clients themselves (dependencies are injected)."
    },
    {
      "id": "dep_direction",
      "class": "dependency",
      "statement": "The design states a dependency direction in which business rules do not depend on transport, storage or vendor code: handlers or adapters call into the domain or service layer, and the domain layer does not import the database, HTTP framework or supplier SDK."
    }
  ],
