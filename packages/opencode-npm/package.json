{
  "name": "@ccoalm/ccl-skills-opencode",
  "version": "0.1.4",
  "description": "OpenCode distribution shell for ccl-skills: bootstrap-injecting plugin + install/update/doctor/uninstall CLI",
  "type": "module",
  "main": "./dist/index.js",
  "oc-plugin": [
    "server",
    "tui"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ccl-skills-opencode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-assets.mjs",
    "test": "npm run verify",
    "verify": "node scripts/verify.mjs",
    "clean": "rm -rf dist *.tgz",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "opencode",
    "ccl-skills",
    "plugin",
    "cli"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  }
}
